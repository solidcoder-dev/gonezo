{
  "customSyntax": "postcss-scss",
  "extends": ["stylelint-config-standard-scss"],
  "plugins": ["stylelint-scss"],
  "ignoreFiles": [
    "node_modules/**/*.css",
    "dist/**/*.css",
    "build/**/*.css"
  ],
  "overrides": [
    {
      "files": ["src/styles/bootstrap.scss", "src/styles/_gonezo-tokens.scss", "src/styles/_theme-colors.generated.scss"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "color-function-notation": null,
        "declaration-property-value-disallowed-list": null,
        "selector-disallowed-list": null
      }
    },
    {
      "files": ["src/analytics/**/*.{css,scss}", "src/movements/ui/MovementsSearch/**/*.{css,scss}"],
      "rules": {
        "declaration-property-value-disallowed-list": {
          "/^.+$/": ["/var\\(--gz-legacy-/"]
        }
      }
    },
    {
      "files": ["src/**/*.module.css"],
      "rules": {
        "selector-disallowed-list": null
      }
    }
  ],
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "color-function-notation": null,
    "declaration-block-no-duplicate-properties": true,
    "declaration-no-important": true,
    "no-duplicate-selectors": true,
    "selector-class-pattern": null,
    "declaration-block-single-line-max-declarations": null,
    "color-function-alias-notation": null,
    "alpha-value-notation": null,
    "media-feature-range-notation": null,
    "no-descending-specificity": null,
    "at-rule-empty-line-before": null,
    "custom-property-empty-line-before": null,
    "scss/dollar-variable-empty-line-before": null,
    "scss/operator-no-newline-after": null,
    "property-no-deprecated": null,
    "selector-not-notation": null,
    "keyframes-name-pattern": null,
    "comment-empty-line-before": null,
    "color-hex-length": null,
    "selector-disallowed-list": [
      "/^button$/",
      "/^input$/",
      "/^select$/",
      "/^textarea$/",
      "/^\\.(?:card|toast|chip|hint|icon-button|text-button|field-error|stack)$/"
    ],
    "declaration-property-value-disallowed-list": {
      "/^.+$/": [
        "/var\\(--gz-legacy-/",
        "/#[0-9a-fA-F]{3,8}/",
        "/rgba?\\(\\s*[0-9]/",
        "/hsla?\\(\\s*[0-9]/"
      ]
    },
    "declaration-block-no-redundant-longhand-properties": null
  }
}
