{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.14.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node ./scripts/generate-theme-colors.mjs",
    "build": "npm run typecheck && vite build",
    "build:bundle": "vite build",
    "lint:js": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint",
    "lint": "npm run lint:js && npm run lint:css",
    "stylelint": "stylelint \"src/**/*.{css,scss}\" --max-warnings 0",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "lint:css": "npm run stylelint",
    "lint:css:fix": "npm run stylelint:fix",
    "typecheck": "tsc -b --pretty false",
    "check:architecture": "depcruise src --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json",
    "check:architecture:graph": "depcruise src --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json --output-type html --output-to build/dependency-graph.html",
    "check:structure": "node ./scripts/check-src-structure.mjs",
    "check:styles": "node ./scripts/check-style-architecture.mjs",
    "check:contrast": "node ./scripts/check-color-contrast.mjs",
    "check": "bash ../scripts/verify-frontend.sh",
    "test": "npm run test:node && npm run test:dom:1 && npm run test:dom:2 && npm run test:architecture",
    "test:node": "vitest run --project node",
    "test:dom:1": "vitest run --project dom --shard=1/2",
    "test:dom:2": "vitest run --project dom --shard=2/2",
    "test:architecture": "vitest run --project architecture",
    "test:watch": "vitest",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:check-16kb": "node ./scripts/check-16kb-alignment.mjs",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "postcss-scss": "^4.0.9",
    "sass": "1.77.8",
    "stylelint": "^16.25.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-scss": "^6.12.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
